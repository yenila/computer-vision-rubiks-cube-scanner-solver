generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ScanStatus {
  VALID
  INVALID
  SOLVED
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  passwordHash       String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  scans              CubeScan[]
  solveHistory       SolveHistory[]
  leaderboardEntries LeaderboardEntry[]
}

model CubeScan {
  id        String         @id @default(cuid())
  userId    String
  name      String
  status    ScanStatus     @default(VALID)
  scan      Json
  solution  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  solves    SolveHistory[]

  @@index([userId, createdAt])
}

model SolveHistory {
  id         String    @id @default(cuid())
  userId     String
  scanId     String?
  solution   Json
  durationMs Int
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan       CubeScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model LeaderboardEntry {
  id         String   @id @default(cuid())
  userId     String
  bestTimeMs Int
  solves     Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([bestTimeMs])
}
