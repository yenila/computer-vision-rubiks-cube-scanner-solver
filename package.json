{
  "name": "computer-vision-rubiks-cube-scanner-and-solver",
  "private": true,
  "version": "0.1.0",
  "description": "Computer vision Rubik’s Cube scanner and solver with guided scanning, verified solutions, and interactive 3D demonstrations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm --workspace packages/shared run build",
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm-run-all build:*",
    "build:shared": "tsc -p packages/shared/tsconfig.json",
    "build:web": "cd apps/web && tsc -b && vite build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "test": "npm-run-all test:*",
    "test:shared": "npm --workspace packages/shared run test",
    "test:web": "npm --workspace apps/web run test",
    "test:api": "npm --workspace apps/api run test",
    "lint": "npm-run-all lint:*",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:api": "npm --workspace apps/api run lint",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "seed": "tsx apps/api/prisma/seed.ts"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
