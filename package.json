{
  "name": "computer-vision-rubiks-cube-scanner-and-solver",
  "private": true,
  "version": "0.1.0",
  "description": "Computer vision Rubik’s Cube scanner and solver with guided scanning, verified solutions, and interactive 3D demonstrations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm --workspace packages/shared run build",
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm-run-all build:*",
    "build:shared": "npm --workspace packages/shared run build",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "test": "npm-run-all test:*",
    "test:shared": "npm --workspace packages/shared run test",
    "test:web": "npm --workspace apps/web run test",
    "test:api": "npm --workspace apps/api run test",
    "lint": "npm-run-all lint:*",
    "lint:web": "npm --workspace apps/web run lint",
    "lint:api": "npm --workspace apps/api run lint",
    "prisma:generate": "npm --workspace apps/api run prisma:generate",
    "prisma:migrate": "npm --workspace apps/api run prisma:migrate",
    "seed": "npm --workspace apps/api run seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
