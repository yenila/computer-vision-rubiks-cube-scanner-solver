{
  "name": "computer-vision-rubiks-cube-scanner-and-solver",
  "private": true,
  "version": "0.1.0",
  "description": "Computer vision Rubik’s Cube scanner and solver with guided scanning, verified solutions, and interactive 3D demonstrations.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/run-workspace.cjs packages/shared build",
    "dev": "npm-run-all --parallel dev:*",
    "dev:web": "node scripts/run-workspace.cjs apps/web dev",
    "dev:api": "node scripts/run-workspace.cjs apps/api dev",
    "build": "npm-run-all build:*",
    "build:shared": "node scripts/run-workspace.cjs packages/shared build",
    "build:web": "node scripts/run-workspace.cjs apps/web build",
    "build:api": "node scripts/run-workspace.cjs apps/api build",
    "test": "npm-run-all test:*",
    "test:shared": "node scripts/run-workspace.cjs packages/shared test",
    "test:web": "node scripts/run-workspace.cjs apps/web test",
    "test:api": "node scripts/run-workspace.cjs apps/api test",
    "lint": "npm-run-all lint:*",
    "lint:web": "node scripts/run-workspace.cjs apps/web lint",
    "lint:api": "node scripts/run-workspace.cjs apps/api lint",
    "prisma:generate": "node scripts/run-workspace.cjs apps/api prisma:generate",
    "prisma:migrate": "node scripts/run-workspace.cjs apps/api prisma:migrate",
    "seed": "node scripts/run-workspace.cjs apps/api seed"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
